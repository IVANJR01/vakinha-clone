# Configuração do Servidor e Gateway VizionPay (VizzionPay)
PORT=3000

# URL Oficial da API VizzionPay:
VIZIONPAY_API_URL=https://app.vizzionpay.com.br/api/v1

# Chaves de API do Produtor (obtidas no painel VizzionPay):
VIZIONPAY_API_KEY=
VIZIONPAY_SECRET_KEY=
VIZIONPAY_WEBHOOK_SECRET=

# Configuração de Recebimento 100% White-Label
PIX_KEY=doacao@vakinha.com.br
PIX_RECEIVER_NAME=VAKINHA PLATAFORMA
PIX_CITY=PORTO ALEGRE
