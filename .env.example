# Configuração do Servidor e Gateway VizionPay
PORT=3000

# Credenciais da API VizionPay (VizzionPay)
# Obtenha em seu painel: https://vizzionpay.com.br ou app.vizzionpay.com
VIZIONPAY_API_URL=https://api.vizzionpay.com.br/v1
VIZIONPAY_API_KEY=
VIZIONPAY_SECRET_KEY=
VIZIONPAY_WEBHOOK_SECRET=

# Modo de Operação: Se VIZIONPAY_API_KEY estiver vazia, o sistema roda em
# modo Sandbox/Simulação Avançada com geração real de QR Code e Pix Copia e Cola.
